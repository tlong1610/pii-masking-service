{
  "schemaVersion": 1,
  "engine": "mongodb",
  "collection": "customers",
  "fields": [
    {
      "path": "Address",
      "group": "co_ban",
      "pii_type": "ADDRESS",
      "action": "MASK"
    },
    {
      "path": "CustomerId",
      "group": "co_ban",
      "pii_type": "CUSTOMER_ID",
      "action": "HMAC",
      "when": {
        "field": "EnterpriseCustomer",
        "equals": false
      }
    },
    {
      "path": "DateOfBirth",
      "group": "co_ban",
      "pii_type": "DOB",
      "action": "MASK"
    },
    {
      "path": "Email",
      "group": "co_ban",
      "pii_type": "EMAIL",
      "action": "HMAC"
    },
    {
      "path": "FullName",
      "group": "co_ban",
      "pii_type": "FULL_NAME",
      "action": "MASK"
    },
    {
      "path": "IdNumber",
      "group": "co_ban",
      "pii_type": "CCCD",
      "action": "HMAC"
    },
    {
      "path": "PhoneNumber",
      "group": "co_ban",
      "pii_type": "PHONE",
      "action": "PARTIAL"
    },
    {
      "path": "SapCustomerId",
      "group": "co_ban",
      "pii_type": "CUSTOMER_ID",
      "action": "HMAC",
      "when": {
        "field": "EnterpriseCustomer",
        "equals": false
      }
    },
    {
      "path": "TaxRegistrationName",
      "group": "co_ban",
      "pii_type": "FULL_NAME",
      "action": "MASK",
      "when": {
        "field": "EnterpriseCustomer",
        "equals": false
      }
    },
    {
      "path": "TaxRegistrationNumber",
      "group": "co_ban",
      "pii_type": "TAX_CODE",
      "action": "MASK",
      "when": {
        "field": "EnterpriseCustomer",
        "equals": false
      }
    },
    {
      "path": "c1",
      "group": "co_ban",
      "pii_type": "CCCD",
      "action": "MASK"
    },
    {
      "path": "c2",
      "group": "co_ban",
      "pii_type": "PHONE",
      "action": "PARTIAL"
    }
  ]
}
