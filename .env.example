# Chép thành .env rồi điền. File .env không được commit.

# --- Che PII ---
# Khoá HMAC, bắt buộc điền. Sinh bằng: openssl rand -hex 32
# Đổi khoá hoặc đổi version làm mọi giá trị HMAC đổi theo, mất khả năng nối với dữ liệu đã xuất trước đó.
HMAC_SECRET=
HMAC_KEY_VERSION=v1

# --- NER cho văn bản tự do ---
# Bật thì phải cài gliner (đang để comment trong requirements.txt).
ENABLE_NER=false
NER_MODEL_NAME=urchade/gliner_multi_pii-v1
# File JSON dạng {"LOAI_PII": ["từ khoá", ...]}; để trống thì bỏ qua tầng từ điển.
NER_DICTIONARY_PATH=

# --- Nguồn MongoDB mà tool đọc ---
# Luôn dùng tài khoản chỉ đọc. Giữ dấu nháy vì URI có ký tự & và ?.
MONGO_URI="mongodb://mockup_ro:mockup_ro@localhost:27017/mockup?authSource=admin"
MONGO_DB=mockup
# Trường đánh dấu khách doanh nghiệp: dòng có giá trị true giữ nguyên mã khách, mã số thuế, số khung, serial.
ENTERPRISE_FLAG_FIELD=EnterpriseCustomer

# --- MongoDB mockup trong docker compose ---
# Tên DB, user và mật khẩu chỉ có hiệu lực khi volume còn trống. Đổi sau đó: docker compose down -v
# Mật khẩu nằm trong URI nên không dùng ký tự @ : / ? #.
MOCKUP_MONGO_DB=mockup
MOCKUP_MONGO_ROOT_USER=admin
MOCKUP_MONGO_ROOT_PASSWORD=admin
MOCKUP_MONGO_READONLY_USER=mockup_ro
MOCKUP_MONGO_READONLY_PASSWORD=mockup_ro
# Chỉ mockup.load_mongo và mockup.load_perf dùng URI này (có quyền ghi), không trỏ tới nguồn thật.
MOCKUP_MONGO_URI="mongodb://admin:admin@localhost:27017/?authSource=admin"
